{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      // Reuse this repo's runners/tools/types unchanged. `@/lib/...` resolves to
      // the parent project, exactly like the iii worker does.
      "@/*": ["../*"]
    }
  },
  "include": ["agent/**/*.ts", "shared/**/*.ts", "eve.config.ts", "eve.d.ts"]
}
